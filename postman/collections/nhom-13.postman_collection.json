{
  "info": {
    "name": "FIT4110 Lab03 - Nhom 13 Analytics Service",
    "_postman_id": "nhom-13-lab03-analytics-service",
    "description": "Postman contract tests for Nhom 13 Analytics Service using Prism mock server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Health response has ok status', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('ok');",
                  "    pm.expect(json.service).to.eql('analytics-service');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Dashboard Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/dashboard/overview?date=2026-05-02"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Dashboard has date and cards', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.date).to.eql('2026-05-02');",
                  "    pm.expect(json.cards).to.be.an('array');",
                  "    pm.expect(json.cards.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Daily Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/analytics/daily-summary?date=2026-05-02"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Daily summary has required fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('date');",
                  "    pm.expect(json).to.have.property('totalAccess');",
                  "    pm.expect(json).to.have.property('totalAlerts');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
